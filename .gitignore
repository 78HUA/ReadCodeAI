# Build output
target/
build/
*.class

# IDE
.idea/
*.iml
.vscode/
*.ipr
*.iws

# Tool / session state (agent scratch, not project content)
.zcode/

# Logs
*.log
logs/

# Private notes (interview prep, handoff notes... kept local on purpose)
notes/

# 测试语料（公开仓库不该包含任何本机路径或第三方代码的副本）
sample-repos/

# Local configuration that may hold credentials - never commit
.env
application-local.yml
application-local.properties

# 前端构建产物（npm run build 生成，不提交 —— 免得"改了源码忘了重建"）
src/main/resources/static/
# 前端依赖与本地缓存（本机 npm 全局缓存无写权限，约定用项目内目录绕开）
frontend/node_modules/
frontend/.npm-cache/
frontend/dist/
