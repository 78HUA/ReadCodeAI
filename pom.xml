<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.readcodeai</groupId>
    <artifactId>readcodeai</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>ReadCodeAI</name>
    <description>Codebase understanding agent: static-analysis-backed retrieval with verifiable file/line evidence</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javaparser.version>3.28.2</javaparser.version>
    </properties>

    <dependencies>
        <!-- Web 接口层。注：Boot 4.x 下 spring-boot-starter-web 仍然可用，
             它已改为经由新增的 spring-boot-starter-webmvc 间接引入容器。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            消息队列（RabbitMQ）：索引任务从"进程内队列"换成"持久化队列"。
            换它的判据在 docs/design-outline.md 的选型表里，这里是那条判据**已经满足**：
            索引任务重启就丢（README 已知限制第 8 条），而"不丢"正是 MQ 买得到的东西。
            默认仍是 readcodeai.queue.mode=in-process：没有 broker 时项目照常可用（与 LLM / Redis 同一套降级纪律）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Java 解析：符号表 / 调用图的来源。纯 Java，无 native 依赖 -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>

        <!-- 符号表 / 调用边 / 类型关系都要落库，第 1 步起接入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          答案缓存用的 Redis。**只有这一处用 Redis**，理由写在 AnswerCache 的注释里：
          它省下的是"每次重复提问 10–40 秒 + 几千 token"，收益足够具体；
          而摘要缓存（省 83ms）之类就没必要为它多引一个中间件。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
